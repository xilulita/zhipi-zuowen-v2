{
  "name": "zhipi-zuowen",
  "productName": "智批作文",
  "version": "1.3.0",
  "description": "智批作文 · AI 作文批改工作台（网页版 + Electron 桌面版）",
  "main": "main.js",
  "author": "智批作文",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.zhipi.zuowen",
    "productName": "智批作文",
    "copyright": "Copyright © 2026 智批作文",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "app/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "智批作文-${version}-安装包.${ext}",
      "signAndEditExecutable": false,
      "sign": null
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "智批作文",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "multiLanguageInstaller": true,
      "displayLanguageSelector": false,
      "installerLanguages": [
        "zh_CN"
      ]
    },
    "artifactName": "智批作文-${version}-安装包.${ext}"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xilulita/zhipi-zuowen-v2.git"
  },
  "homepage": "https://github.com/xilulita/zhipi-zuowen-v2#readme"
}
