{
  "name": "zhipi-zuowen",
  "productName": "智批作文",
  "version": "1.2.2",
  "description": "智批作文 · AI 作文批改工作台（网页版 + Electron 桌面版）",
  "main": "main.js",
  "author": "智批作文",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.zhipi.zuowen",
    "productName": "智批作文",
    "copyright": "Copyright © 2026 智批作文",
    "artifactName": "智批作文-${version}-安装包.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "assets/**/*",
      "!assets/*.part.*",
      "docs/**/*",
      "local_ocr/**/*"
    ],
    "asar": true,
    "compression": "maximum",
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": [
        "zh_CN"
      ],
      "language": "2052",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "智批作文",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xilulita/zhipi-zuowen-v2.git"
  },
  "homepage": "https://github.com/xilulita/zhipi-zuowen-v2#readme",
  "bugs": {
    "url": "https://github.com/xilulita/zhipi-zuowen-v2/issues"
  },
  "keywords": [
    "electron",
    "作文批改",
    "ai",
    "education",
    "小学语文"
  ]
}
